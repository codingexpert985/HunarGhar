# ---------- Server ----------
NODE_ENV=development
PORT=5000
# Public URL of this backend (used to build links for locally stored images)
PUBLIC_URL=http://localhost:5000
# Frontend origin(s) allowed by CORS (comma separated)
CLIENT_URL=http://localhost:3000,http://localhost:5173

# ---------- PostgreSQL ----------
# Local:    postgresql://postgres:postgres@localhost:5432/hunarghar
# Supabase: copy the "Connection string (URI)" from Project Settings > Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hunarghar
# Set to true for Supabase / Render / Railway hosted databases
DB_SSL=false

# ---------- Authentication (JWT) ----------
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
MIN_PASSWORD_LENGTH=8

# ---------- Image storage (Cloudinary free tier) ----------
# Leave blank to store uploads on the local disk (/uploads) instead
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_MB=5
